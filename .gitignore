# Python venv for ufbt
.venv/

# ufbt build artifacts and SDK state
.ufbt/
dist/
*.fap
build/

# Real WiFi passwords for auto-join: plaintext, never commit. Only the
# placeholder example is tracked.
networks.txt
!networks.txt.example

# macOS
.DS_Store

# ufbt-generated IDE files
.vscode/compile_commands.json

# Captured serial output (may contain real nearby SSIDs/BSSIDs)
dumps/*
!dumps/list_sample.log
!dumps/scanall_sample.txt
splash_resized.png

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads.gate.lock
.beads/dolt-backup.json
.beads/dolt-backup-state.json

# Built ESP firmware artifacts (regenerate with firmware/build_c5.sh)
firmware/build/
