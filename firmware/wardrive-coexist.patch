diff --git a/esp32_marauder/WiFiScan.cpp b/esp32_marauder/WiFiScan.cpp
index d0b6bc7..f17f834 100644
--- a/esp32_marauder/WiFiScan.cpp
+++ b/esp32_marauder/WiFiScan.cpp
@@ -6001,13 +6001,24 @@ void WiFiScan::executeWarDrive() {
 
         // Only run BLE after the entire weighted WiFi channel list has completed.
         //if (currentScanMode == WIFI_SCAN_WAR_DRIVE && this->wardrive_channel_index >= wardrive_channel_count) {
-        if (currentScanMode == WIFI_SCAN_WAR_DRIVE && this->wardrive_channel_index % 4 == 0) {
+        // Marauder's Mate: gate the BLE phase on wardrive_ble_enabled (`wardrive -w`
+        // runs WiFi-only). When enabled, TIME-SLICE the radios: the BLE scan and
+        // WiFi must not run concurrently or NimBLE's NPL event pool is exhausted
+        // (npl_freertos_event_init assert, observed on the ESP32-C5). Tearing WiFi
+        // fully down here means the BLE window runs alone; the !ble_scanning
+        // branch below re-inits WiFi (the shutdownWiFi/startWardriverWiFi pair is
+        // the same one the WIFI_SCAN_FAILED path already uses).
+        if (currentScanMode == WIFI_SCAN_WAR_DRIVE && this->wardrive_ble_enabled &&
+            this->wardrive_channel_index % 4 == 0) {
           #ifdef HAS_BT
             this->bt_pending_clear = true;
 
             while (bt_cb_busy)
               delay(100);
 
+            this->wifi_initialized = true;
+            this->shutdownWiFi();
+
             pBLEScan->clearResults();
 
             #ifdef HAS_NIMBLE_2
@@ -6031,6 +6042,14 @@ void WiFiScan::executeWarDrive() {
         uint8_t scan_channel = wardrive_channels[this->wardrive_channel_index];
         this->wardrive_channel_index++;
 
+        // Marauder's Mate: WiFi is torn down for the BLE window above, so bring
+        // it back before scanning. Harmless (a mode set + disconnect) when WiFi
+        // is already initialized on a normal WiFi-only cycle.
+        if (!this->wifi_initialized) {
+          this->startWardriverWiFi();
+          this->wifi_initialized = true;
+        }
+
         #ifdef HAS_DUAL_BAND
           WiFi.scanNetworks(true, true, false, 80, scan_channel);
         #else
